{n  "app_name": "TableSizeCalculator-Development",n  "log_level": "DEBUG",n  "output_table": "dev.table_size_analysis",n  "summary_output_path": "/tmp/dev_table_size_summary.json",n  "spark_configs": {n    "spark.sql.adaptive.enabled": "true",n    "spark.sql.adaptive.coalescePartitions.enabled": "true",n    "spark.sql.adaptive.skewJoin.enabled": "true",n    "spark.serializer": "org.apache.spark.serializer.KryoSerializer",n    "spark.sql.execution.arrow.pyspark.enabled": "true",n    "spark.driver.memory": "2g",n    "spark.driver.maxResultSize": "1g",n    "spark.executor.memory": "4g",n    "spark.executor.cores": "2",n    "spark.executor.instances": "2",n    "spark.sql.shuffle.partitions": "50"n  },n  "databases_to_exclude": [n    "information_schema",n    "sys"n  ],n  "table_size_threshold_mb": 1,n  "enable_detailed_logging": true,n  "max_tables_per_database": 100,n  "timeout_seconds": 1800n}